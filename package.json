{
  "name": "universal-course-extractor",
  "version": "0.1.0",
  "description": "Extrai conhecimento de plataformas de cursos online e gera notas Markdown para Obsidian.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:ai": "tsx src/index.ts test-ai",
    "test:ai:vitest": "vitest run --config vitest.ai.config.ts",
    "check-config": "tsx src/index.ts check-config",
    "scrape": "tsx src/index.ts",
    "auth": "tsx src/index.ts auth"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.8.0",
    "commander": "^15.1.0",
    "dotenv": "^18.0.10",
    "openai": "^7.55.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "playwright": "^1.65.0",
    "sanitize-html": "^2.18.2",
    "slugify": "^1.6.9",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/sanitize-html": "^2.16.2",
    "@types/turndown": "^5.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
