{
  "name": "universal-course-extractor",
  "version": "0.1.0",
  "description": "Extrai conhecimento de plataformas de cursos online e gera notas Markdown para Obsidian.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "scrape": "tsx src/index.ts",
    "auth": "tsx src/index.ts auth"
  },
  "dependencies": {
    "commander": "^15.1.0",
    "dotenv": "^18.0.10",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "playwright": "^1.65.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
